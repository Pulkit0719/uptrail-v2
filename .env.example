# Application
PORT=3000
TRUST_PROXY=false
OWNER_USER_ID=

# MySQL (replace every example password outside local development)
DATABASE_URL=mysql://uptrail:change-me@127.0.0.1:3306/uptrail
MYSQL_DATABASE=uptrail
MYSQL_USER=uptrail
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-password

# OpenAI-compatible provider; keys are read only by the server
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_CHAT_MODEL=gpt-5-mini
AI_IMAGE_MODEL=gpt-image-1
AI_TRANSCRIPTION_MODEL=whisper-1

# S3-compatible private object storage
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=uptrail
S3_ACCESS_KEY_ID=uptrail-local
S3_SECRET_ACCESS_KEY=change-storage-password
S3_FORCE_PATH_STYLE=true
MINIO_ROOT_USER=uptrail-local
MINIO_ROOT_PASSWORD=change-storage-password

# Optional generic HTTPS webhook for owner notifications
NOTIFICATION_WEBHOOK_URL=
