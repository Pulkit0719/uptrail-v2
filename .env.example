# ==============================================================================
# Uptrail V2 — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure the variables for your environment.
# Never commit real credentials, certificates, or private keys to source control.
# Run `pnpm config:check` to validate configuration status without exposing values.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Runtime
# ------------------------------------------------------------------------------
PORT=3000
# Canonical public URL (must be HTTPS in production, e.g. https://uptrail-v2.onrender.com)
APP_BASE_URL=http://localhost:3000
# Set to 'true' when running behind a trusted reverse proxy (e.g. Render, Cloudflare)
TRUST_PROXY=false
# Numeric database ID of the user granted administrative owner privileges (e.g. 1)
OWNER_USER_ID=

# ------------------------------------------------------------------------------
# 2. Database (MySQL 8.4+ / Aiven / Local)
# ------------------------------------------------------------------------------
# MySQL connection URI; append ?ssl-mode=REQUIRED for TLS-enforced connections
DATABASE_URL=mysql://uptrail_app:replace-with-strong-password@mysql.example.invalid:3306/uptrail?ssl-mode=REQUIRED
# Maximum number of concurrent database pool connections
DATABASE_POOL_SIZE=10
# Path to a local PEM certificate file for verifying the database CA (optional)
DATABASE_SSL_CA_FILE=
# Inline PEM certificate string for containerized environments without volume mounts (optional)
DATABASE_SSL_CA=
# Local development container credentials (used by docker-compose)
MYSQL_DATABASE=uptrail
MYSQL_USER=uptrail
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-password

# ------------------------------------------------------------------------------
# 3. AI Career Mentor (OpenRouter / OpenAI-Compatible)
# ------------------------------------------------------------------------------
# Base API endpoint for OpenAI-compatible completions
AI_BASE_URL=https://openrouter.ai/api/v1
# Secret API key (read server-side only; never bundled into browser code)
AI_API_KEY=
# Model identifier; locked to zero-cost free models (e.g. openrouter/free)
AI_CHAT_MODEL=openrouter/free
# Provider timeout in milliseconds
AI_REQUEST_TIMEOUT_MS=30000
# Maximum output tokens per completion
AI_MAX_OUTPUT_TOKENS=800
# Maximum retry attempts on retryable HTTP errors (408, 429, 500, 502, 503, 504)
AI_MAX_RETRIES=2

# ------------------------------------------------------------------------------
# 4. Transactional Email & Password Recovery (Optional)
# ------------------------------------------------------------------------------
# HTTP webhook endpoint accepting {from, to, subject, text, html} JSON with Bearer auth
EMAIL_PROVIDER_URL=
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=
# Validity period for single-use password reset tokens in minutes (1–120)
PASSWORD_RESET_TTL_MINUTES=30

# ------------------------------------------------------------------------------
# 5. Administrative Notifications (Optional)
# ------------------------------------------------------------------------------
# Generic HTTPS webhook endpoint for system event notifications
NOTIFICATION_WEBHOOK_URL=
