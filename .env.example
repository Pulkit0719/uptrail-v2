# Application
PORT=3000
APP_BASE_URL=http://localhost:3000
TRUST_PROXY=false
OWNER_USER_ID=

# MySQL (replace every example password outside local development)
DATABASE_URL=mysql://uptrail_app:replace-with-strong-password@mysql.example.invalid:3306/uptrail?ssl-mode=REQUIRED
DATABASE_POOL_SIZE=10
# Set for hosted MySQL when the provider supplies a private CA. The file must
# contain PEM certificate contents; never commit the real certificate.
DATABASE_SSL_CA_FILE=
MYSQL_DATABASE=uptrail
MYSQL_USER=uptrail
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-password

# OpenAI-compatible provider; keys are read only by the server
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_CHAT_MODEL=gpt-5-mini
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_OUTPUT_TOKENS=800
AI_MAX_RETRIES=2

# Transactional email HTTP provider. The endpoint must accept
# {from,to,subject,text,html} JSON with a Bearer token.
EMAIL_PROVIDER_URL=
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=
PASSWORD_RESET_TTL_MINUTES=30

# Optional generic HTTPS webhook for owner notifications
NOTIFICATION_WEBHOOK_URL=
